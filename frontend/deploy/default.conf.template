# Production web server: the built app, plus the API proxied to the backend so the browser
# talks to one origin (needed for the secure session cookie). BACKEND_URL is filled in at
# start-up from the environment (e.g. http://backend inside Azure Container Apps).

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;
    client_max_body_size 5m;

    location ~ ^/(api|auth|mcp)(/|$) {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        # The backend's own host name (internal routing); the public one is passed along.
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location /.well-known/oauth-protected-resource {
        proxy_pass ${BACKEND_URL};
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Fingerprinted build files never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff;
        try_files $uri =404;
    }

    # The installable-app manifest (phone home screen, push notifications).
    location = /manifest.webmanifest {
        types { application/manifest+json webmanifest; }
        add_header Cache-Control "no-cache";
    }

    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff;
        add_header Referrer-Policy strict-origin-when-cross-origin;
        add_header X-Frame-Options DENY;
        # Only the app's own code runs. Inline styles are allowed (the UI library injects
        # them); inline scripts are not. Images may be data:/blob: (logo preview).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        try_files $uri /index.html;
    }
}
